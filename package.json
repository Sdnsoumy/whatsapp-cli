{
  "name": "wacli",
  "version": "0.5.0",
  "description": "WhatsApp CLI tool - TypeScript port of whatsapp-cli",
  "type": "module",
  "main": "dist/cmd/main.js",
  "bin": {
    "wacli": "dist/cmd/main.js"
  },
  "scripts": {
    "dev": "tsx src/cmd/main.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "bundle": "ncc build dist/cmd/main.js -o bundle/ --minify",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^6.7.16",
    "better-sqlite3": "^11.10.0",
    "commander": "^13.1.0",
    "mime-types": "^2.1.35",
    "p-queue": "^8.1.0",
    "pino": "^9.6.0",
    "proper-lockfile": "^4.1.2",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/mime-types": "^2.1.4",
    "@types/node": "^22.15.3",
    "@types/proper-lockfile": "^4.1.4",
    "@types/qrcode-terminal": "^0.12.2",
    "@vercel/ncc": "^0.38.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
